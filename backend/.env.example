# Copy this file to `backend/.env` and fill in real values.
# `backend/.env` is git-ignored and imported by Spring Boot (see application.yml).
# The application is run from the `backend/` directory so this file is found.

# JDBC URL for PostgreSQL / Neon. Note: use the `jdbc:` prefix and keep sslmode=require.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USER=<username>
DB_PASSWORD=<password>

# Optional overrides
SERVER_PORT=8080
