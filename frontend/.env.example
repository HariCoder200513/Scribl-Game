# Frontend configuration. All variables must be prefixed with VITE_.
#
# By default the app calls the API on the same origin under `/api`, and the Vite
# dev/preview server proxies that to the backend (see vite.config.ts). Set this
# only when the API lives somewhere else (e.g. a deployed backend):
#
# VITE_API_BASE_URL=https://api.example.com
